---
// 全ページ共通の骨組み（<head>・ヘッダー・予約バー・フッター）
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import StickyCta from '../components/StickyCta.astro';
import { LOCALE_META, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { organizationJsonLd } from '../lib/structured-data';

interface Props {
  lang: Locale;
  title?: string;
  description: string;
  alternates: { lang: Locale; href: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
}

const { lang, jsonLd = [], ...seo } = Astro.props;
const t = useTranslations(lang);
// フォント: 欧文 Figtree ＋ 和文 Noto Sans JP（design/design.md §3）
const fonts =
  'https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap';
---

<!doctype html>
<html lang={LOCALE_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" content="#072ac8" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <Seo lang={lang} {...seo} jsonLd={[organizationJsonLd(Astro.site!), ...jsonLd]} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('site.skipToContent')}</a>
    <Header lang={lang} alternates={seo.alternates} />
    <main id="main">
      <slot />
    </main>
    <StickyCta lang={lang} />
    <Footer lang={lang} />
  </body>
</html>
