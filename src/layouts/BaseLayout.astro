---
// 全ページ共通の骨組み（<head>・ヘッダー・予約バー・フッター）
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import StickyCta from '../components/StickyCta.astro';
import { LOCALE_META, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { organizationJsonLd } from '../lib/structured-data';

interface Props {
  lang: Locale;
  title?: string;
  description: string;
  alternates: { lang: Locale; href: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
}

const { lang, jsonLd = [], ...seo } = Astro.props;
const t = useTranslations(lang);
// フォント: 欧文 Figtree ＋ 和文 Noto Sans JP（design/design.md §3）。
// 中国語のページは、簡体字・繁体字の字形に合わせて Noto Sans SC / TC を使う（tokens.css の :lang() 指定と対応）
const cjkFont = { ja: 'Noto+Sans+JP', en: 'Noto+Sans+JP', 'zh-hans': 'Noto+Sans+SC', 'zh-hant': 'Noto+Sans+TC' }[lang];
const fonts = `https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;900&family=${cjkFont}:wght@400;500;700;900&display=swap`;
---

<!doctype html>
<html lang={LOCALE_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- ファビコン（scripts/make-favicons.mjs でロゴから作成） -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#072ac8" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <Seo lang={lang} {...seo} jsonLd={[organizationJsonLd(Astro.site!), ...jsonLd]} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('site.skipToContent')}</a>
    <Header lang={lang} alternates={seo.alternates} />
    <main id="main">
      <slot />
    </main>
    <StickyCta lang={lang} />
    <Footer lang={lang} />
  </body>
</html>

<script>
  // スクロールで要素がふわっと現れる動き（見た目は global.css の .reveal）。
  // - 最初から画面に見えている要素は隠さない（表示直後のちらつきを防ぐ）
  // - 「動きを減らす」設定の人と、古いブラウザでは何もしない（最初からすべて表示）
  // - 現れ終わったら class を外し、カードの hover などの元の動きに戻す
  const TARGETS = [
    '.section-head',
    '.feature',
    '.card',
    '.split > *',
    '.schedule__item',
    '.steps__item',
    '.faq__item',
    '.news-list > li',
    '.member-points > li',
    '.sponsors__item',
    '.cta-panel',
    '.prose > h2',
    '.prose > p:has(> img)',
    '.prose > .gallery',
    '.prose > table',
    '.prose > blockquote',
  ].join(',');
  const STAGGER_MS = 90;
  const MAX_DELAY_MS = 450;

  if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        // 同時に見えてきた要素（カードの列など）は、少しずつ時間をずらして出す
        const shown = entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement);
        shown.forEach((el, i) => {
          observer.unobserve(el);
          el.style.setProperty('--reveal-delay', `${Math.min(i * STAGGER_MS, MAX_DELAY_MS)}ms`);
          el.classList.add('is-revealed');
          const done = () => {
            el.classList.remove('reveal', 'is-revealed');
            el.style.removeProperty('--reveal-delay');
          };
          el.addEventListener('transitionend', done, { once: true });
          setTimeout(done, 1500); // transitionend が来ない場合の保険
        });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    for (const el of document.querySelectorAll<HTMLElement>(TARGETS)) {
      // 対象の中にある対象（地図欄の見出しなど）は、外側と一緒に動かす（二重に動かさない）
      if (el.parentElement?.closest(TARGETS)) continue;
      if (el.getBoundingClientRect().top < window.innerHeight) continue;
      el.classList.add('reveal');
      observer.observe(el);
    }
  }
</script>
