---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { formatDate } from '../lib/format';
import { newsUrl, splitId, type NewsEntry } from '../lib/content';
import { articleJsonLd } from '../lib/structured-data';

interface Props {
  lang: Locale;
  post: NewsEntry;
}

const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);
const { title, date, description, image, imageAlt } = post.data;
const url = newsUrl(lang, splitId(post.id).slug);
const ogImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
// 本文の最初の120字程度を説明文にする（description があればそちらを優先）
const summary =
  description ??
  (post.body ?? '')
    .replace(/[#>*_`\[\]()!|-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 120);
const jsonLd = [
  articleJsonLd({ title, date, url, siteUrl: Astro.site!, image: ogImage ? new URL(ogImage.src, Astro.site).href : undefined }),
];
---

<BaseLayout lang={lang} title={title} description={summary} alternates={[{ lang, href: url }]} image={image} imageAlt={imageAlt} type="article" jsonLd={jsonLd}>
  <PageHero eyebrow={t('news.eyebrow')} meta={formatDate(date, lang)} title={title} image={image} imageAlt={imageAlt} />
  <section class="section">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
      <a class="more-link" href={newsUrl(lang)}>
        {t('news.backToList')}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>
</BaseLayout>
