---
// セーリング体験会・イベントの開催日（src/data/schedule.yaml から表示）
import Icon from './Icon.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { getPlace, pick, site, upcomingSchedule } from '../lib/data';
import { formatDate } from '../lib/format';

interface Props {
  lang: Locale;
  /** 表示する最大件数 */
  limit?: number;
  /** 予約ボタンを主ボタン（黄色）にする。1画面に黄色のボタンはひとつだけ */
  primary?: boolean;
}

const { lang, limit, primary = false } = Astro.props;
const t = useTranslations(lang);
const items = upcomingSchedule().slice(0, limit);
const hasReservable = items.some((i) => i.kind === 'experience' && i.status === 'scheduled');
const badge = (item: (typeof items)[number]) => {
  if (item.status === 'cancelled') return { tone: 'danger', label: t('schedule.cancelled') };
  if (item.status === 'full') return { tone: 'danger', label: t('schedule.full') };
  if (item.kind === 'event') return { tone: 'info', label: t('schedule.event') };
  return { tone: 'success', label: t('schedule.open') };
};
---

<div class="schedule">
  <p class="schedule__empty" hidden={items.length > 0}>{t('schedule.empty')}</p>
  {
    items.length > 0 && (
      <ul class="grid schedule__list">
        {items.map((item) => {
          const place = getPlace(item.place);
          const b = badge(item);
          return (
            <li class="schedule__item" data-date={item.date} data-status={item.status} data-reservable={String(item.kind === 'experience' && item.status === 'scheduled')}>
              <div class="schedule__head">
                <time class="schedule__date" datetime={item.date}>
                  {formatDate(item.date, lang, { weekday: true, year: false })}
                </time>
                <span class={`badge badge--${b.tone}`}>{b.label}</span>
              </div>
              {item.title && <p class="schedule__title">{pick(item.title, lang)}</p>}
              {item.start && (
                <p class="schedule__meta">
                  <Icon name="clock" size={16} />
                  {item.start}
                  {item.end && `–${item.end}`}
                  {item.note && `（${pick(item.note, lang)}）`}
                </p>
              )}
              <p class="schedule__meta">
                <Icon name="map-pin" size={16} />
                {place.mapUrl ? (
                  <a href={place.mapUrl} rel="noopener">
                    {pick(place.name, lang)}
                  </a>
                ) : (
                  pick(place.name, lang)
                )}
              </p>
              {!item.start && item.note && <p class="schedule__deadline">{pick(item.note, lang)}</p>}
              {item.kind === 'experience' && item.status === 'scheduled' && (
                <p class="schedule__deadline">
                  {t('schedule.deadline')}：{formatDate(item.deadline, lang, { weekday: true, year: false })}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    )
  }
  {
    hasReservable && (
      <p class="schedule__cta" data-schedule-cta>
        <a class:list={['button', primary ? 'button--primary button--lg' : 'button--secondary']} href={site.forms.experience} rel="noopener" data-track="reserve_experience">
          {t('schedule.reserve')}
          <Icon name="arrow-right" size={18} />
        </a>
      </p>
    )
  }
</div>

<script>
  // サイトは更新（ビルド）したときの日付で作られるため、その後に過ぎた日程をブラウザ側で隠す。
  // すべての日程が過ぎていたら「現在ご案内できる開催日はありません」を表示する。
  const today = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Tokyo' }).format(new Date());
  document.querySelectorAll<HTMLElement>('.schedule').forEach((schedule) => {
    const items = [...schedule.querySelectorAll<HTMLElement>('.schedule__item[data-date]')];
    items.forEach((el) => {
      if ((el.dataset.date ?? '') < today) el.hidden = true;
    });
    const upcoming = items.filter((el) => !el.hidden);
    const reservable = upcoming.some((el) => el.dataset.reservable === 'true');
    const empty = schedule.querySelector<HTMLElement>('.schedule__empty');
    const cta = schedule.querySelector<HTMLElement>('[data-schedule-cta]');
    if (empty) empty.hidden = upcoming.length > 0;
    if (cta) cta.hidden = !reservable;
  });
</script>
