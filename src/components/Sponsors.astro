---
// パートナー・スポンサー一覧（site.yaml の sponsors）。
// logo が指定されていればロゴ画像、なければ名前を表示する。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { site } from '../lib/data';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{png,jpg,jpeg,webp,svg}', { eager: true });
const sponsors = site.sponsors.map((s) => {
  const key = s.logo ? `../assets/${s.logo.replace(/^\/?(src\/)?assets\//, '')}` : undefined;
  if (key && !logos[key]) throw new Error(`site.yaml: スポンサー "${s.name}" のロゴ ${s.logo} が src/assets/ にありません`);
  return { ...s, image: key ? logos[key].default : undefined };
});
---

<section class="section sponsors" aria-labelledby="sponsors-heading">
  <div class="container">
    <SectionHead id="sponsors-heading" eyebrow={t('sponsors.eyebrow')} title={t('sponsors.heading')} />
    <ul class="grid sponsors__list">
      {
        sponsors.map((s) => {
          const content = s.image ? <Image src={s.image} alt={s.name} height={56} /> : s.name;
          return <li class="sponsors__item">{s.url ? <a href={s.url} rel="noopener">{content}</a> : <span>{content}</span>}</li>;
        })
      }
    </ul>
  </div>
</section>
