---
// <head> 内の検索エンジン・SNS向け情報。
// title / description / canonical / hreflang / OGP / 構造化データ（JSON-LD）を出力する。
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { DEFAULT_LOCALE, LOCALE_META, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { site } from '../lib/data';

interface Props {
  lang: Locale;
  /** ページ名。省略するとトップページ用のタイトルになる */
  title?: string;
  description: string;
  /** 翻訳が存在する言語と、その URL（自分自身を含む） */
  alternates: { lang: Locale; href: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
}

const { lang, title, description, alternates, image, imageAlt, type = 'website', jsonLd = [] } = Astro.props;
const siteUrl = Astro.site!;
const fullTitle = title ? `${title} | ${site.name}` : useTranslations(lang)('site.homeTitle');
// OGP の言語コード
const ogLocale = { ja: 'ja_JP', en: 'en_US', 'zh-hans': 'zh_CN', 'zh-hant': 'zh_TW' }[lang];
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
const xDefault = alternates.find((a) => a.lang === DEFAULT_LOCALE);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  alternates.length > 1 &&
    alternates.map((a) => <link rel="alternate" hreflang={LOCALE_META[a.lang].htmlLang} href={new URL(a.href, siteUrl).href} />)
}
{alternates.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, siteUrl).href} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title ?? fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
{ogImage && <meta property="og:image" content={new URL(ogImage.src, siteUrl).href} />}
{ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

<link rel="sitemap" href="/sitemap-index.xml" />
{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
