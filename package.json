{
  "name": "sailability-tokyo-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-images.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:external": "node scripts/check-external-links.mjs",
    "verify": "npm run check && npm run build && npm run check:links && npm test",
    "test": "playwright test",
    "test:update-screenshots": "playwright test tests/visual.spec.ts --update-snapshots=all",
    "photos": "node scripts/add-photos.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
